###############################################################################
# Papers — configuration d'exemple
#
# Copier en .env puis : php artisan key:generate
# Le détail pas à pas est dans README.md.
###############################################################################

APP_NAME=Papers
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# En dev local. Pour tester sur un vrai iPhone, mettre ici le hostname STABLE
# du tunnel nommé (ex. https://dev.mondomaine.com) — voir README §HTTPS.
# APP_URL sert à construire les URLs signées et l'URL du disque « documents ».
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# Base de données — PostgreSQL 18 + pgvector (conteneur papers-postgres)
#
# Port 55432 et non 5432 : le conteneur publie 55432->5432 pour ne pas entrer
# en conflit avec un PostgreSQL déjà installé sur la machine.
# SQLite est impossible ici : le projet a besoin de pgvector, unaccent, pg_trgm
# et de la configuration de recherche plein texte « fr_unaccent ».
#------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=papers
DB_USERNAME=papers
DB_PASSWORD=papers

#------------------------------------------------------------------------------
# Session — c'est l'authentification de la PWA
#
# Cookie de session, PAS de token Bearer : sur iOS, ITP purge localStorage /
# IndexedDB / Cache API après 7 jours sans interaction. Un cookie posé par le
# serveur via Set-Cookie échappe à ce plafond.
#
# SESSION_DRIVER=database (et non cookie) pour pouvoir invalider une session
# côté serveur, et parce que le payload dépasse vite les 4 Ko d'un cookie.
#
# SESSION_LIFETIME=43200 = 30 jours : une app qu'on ouvre quand on reçoit du
# courrier, pas tous les jours.
#------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# false en http://localhost. À PASSER À true dès qu'on passe par le tunnel
# HTTPS : sans le drapeau Secure, Safari refuse le cookie sur une origine
# https et l'utilisateur est déconnecté au rechargement.
SESSION_SECURE_COOKIE=false

#------------------------------------------------------------------------------
# Sanctum
#
# Laisser VIDE en dev. config/sanctum.php retombe alors sur une liste qui
# contient Sanctum::currentRequestHost() : le host de la requête courante
# devient stateful à l'exécution, ce qui fait marcher le tunnel sans toucher
# à la config.
#
# En production (APP_ENV=production) currentRequestHost() est désactivé :
# cette variable devient OBLIGATOIRE, sous peine de 401 en boucle.
#   SANCTUM_STATEFUL_DOMAINS=papers.mondomaine.com
#------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=

#------------------------------------------------------------------------------
# Files / Cache / Redis
#
# Port 56379 -> 6379 dans le conteneur papers-redis.
#
# ATTENTION : « phpredis » est une EXTENSION PHP (php_redis.dll), pas un paquet
# Composer, et elle n'est pas fournie avec les builds Windows de PHP.
# Vérifier :  php -r "echo class_exists('Redis') ? 'OK' : 'MANQUANT';"
# Si elle manque -> QUEUE_CONNECTION=database et CACHE_STORE=database.
#------------------------------------------------------------------------------
QUEUE_CONNECTION=redis

# Volontairement « database » et non « redis » : le cache est sollicité à
# CHAQUE requête (rate limiting, verrous, config). Si phpredis manque, un cache
# redis ferait tomber toute l'application, pas seulement le worker. En
# « database » la panne reste confinée à queue:work, ce qui est bien plus facile
# à diagnostiquer. Passer à redis une fois l'extension installée.
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

# Doit rester > au --timeout du worker (240). Sinon le job est redistribué
# pendant qu'il tourne encore : double appel OpenAI, double facturation.
REDIS_QUEUE_RETRY_AFTER=300
DB_QUEUE_RETRY_AFTER=300

BROADCAST_CONNECTION=log

# Disque privé des scans (storage/app/private/documents), servi uniquement par
# URL signée à durée limitée.
FILESYSTEM_DISK=documents

# Driver d'image pour Illuminate\Support\Facades\Image (intervention/image 4).
# « imagick » est meilleur mais l'extension n'est pas fournie avec les builds
# Windows de PHP ; « gd » l'est. Vérifier : php -m | findstr /i "gd imagick"
IMAGE_DRIVER=gd

MAIL_MAILER=log
MAIL_FROM_ADDRESS="papers@localhost"
MAIL_FROM_NAME="${APP_NAME}"

#------------------------------------------------------------------------------
# OpenAI
#
# NE JAMAIS COMMITER DE CLÉ. .env est dans .gitignore ; ce fichier-ci
# (.env.example) est versionné et doit rester vide sur cette ligne.
#------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Modèle de vision / extraction.
#
# gpt-5.6-terra : tier « équilibre » du lineup 2026 (l'ex-« mini »), à 2 $/1M
# en entrée et 12 $/1M en sortie, soit ~0,02 $ par page A4 scannée en
# detail:"original". C'est le meilleur rapport qualité/prix pour de
# l'extraction documentaire : gpt-5.6-luna est 10x moins cher mais décroche
# sur les scans dégradés, gpt-5.6-sol coûte 2x plus sans gain mesuré sur de la
# facture ou du courrier. Escalade vers sol/astra seulement si la validation
# métier échoue (manuscrit, tableaux denses).
PAPERS_VISION_MODEL=gpt-5.6-terra
PAPERS_VISION_REASONING_EFFORT=low
PAPERS_VISION_SERVICE_TIER=auto

# 1536 dimensions imposées par pgvector : un index HNSW ne peut pas indexer
# au-delà de 2000 dimensions, ce qui exclut text-embedding-3-large (3072).
# Cette valeur DOIT rester alignée avec $table->vector('embedding', 1536).
PAPERS_EMBEDDING_MODEL=text-embedding-3-small
PAPERS_EMBEDDING_DIMENSIONS=1536

# Seule protection réelle contre un appel qui pend : sous Windows, pcntl est
# absent, donc #[Timeout] et queue:work --timeout ne sont pas appliqués.
PAPERS_OPENAI_TIMEOUT=120
PAPERS_OPENAI_CONNECT_TIMEOUT=10

#------------------------------------------------------------------------------
# Papers — divers
#------------------------------------------------------------------------------
PAPERS_CALDAV_CALENDAR_NAME="Papers — Échéances"
PAPERS_CALDAV_TIMEZONE=Europe/Paris

# Jeton d'ingestion du raccourci iOS : usage unique, 10 minutes.
PAPERS_INGEST_TOKEN_TTL=600
# Le nom du raccourci est son seul identifiant : s'il est renommé côté iPhone,
# le lancement échoue silencieusement.
PAPERS_SHORTCUT_NAME=Papers

VITE_APP_NAME="${APP_NAME}"
