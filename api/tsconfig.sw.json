{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "WebWorker"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "types": ["vite/client", "vite-plugin-pwa/client"],

        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noEmit": true
    },
    "include": ["resources/js/sw.ts"]
}
